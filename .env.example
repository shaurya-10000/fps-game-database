# --- Runtime ---
NODE_ENV=production
PORT=10000

# --- MongoDB ---
# In dev: mongodb://localhost:27017/?replicaSet=rs0
# In CI:  set by the replica-set fixture (Phase 0.4)
MONGODB_URI=mongodb://127.0.0.1:27017/fps_dev?replicaSet=rs0?replicaSet=rs0
MONGODB_MAX_POOL_SIZE=20
MONGODB_MAX_CONNECTING=10
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000

# --- Auth (provider-neutral; Phase 2.1) ---
AUTH_JWKS_URI=
AUTH_ISSUER=
AUTH_AUDIENCE=

# --- Observability ---
LOG_LEVEL=info

# --- Failure injection (test only; Phase 0.6) ---
# Must be empty/false unless NODE_ENV=test
FAILURE_INJECTION_ENABLED=false

# --- Auth ---
AUTH_JWKS_URI=https://test-issuer.com/.well-known/jwks.json
AUTH_ISSUER=https://test-issuer.com/
AUTH_AUDIENCE=fps-api