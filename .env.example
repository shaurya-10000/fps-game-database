# --- Runtime ---
NODE_ENV=production
PORT=10000

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017/fps_dev?replicaSet=rs0
MONGODB_MAX_POOL_SIZE=20
MONGODB_MAX_CONNECTING=10
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000

# --- Auth ---
AUTH_JWKS_URI=https://test-issuer.com/.well-known/jwks.json
AUTH_ISSUER=https://test-issuer.com/
AUTH_AUDIENCE=fps-api

# --- Observability ---
LOG_LEVEL=info

# --- Failure injection (test only) ---
FAILURE_INJECTION_ENABLED=false
